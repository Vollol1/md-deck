# md-deck configuration
# Copy this file to .env and adjust as needed

# Path to slides directory (relative to engine directory)
#   Standalone: ./slides (default - inside repo)
#   Submodule:  ../slides (parent project, outside submodule)
SLIDES_DIR=./slides

# Path to themes directory (relative to engine directory)
#   Standalone: ./themes (default - inside repo)
#   Wrapper:    ../themes (wrapper repo, outside the engine)
# Themes in this directory take precedence over the engine's own themes/,
# so a wrapper repo can ship its own branding without touching the engine.
THEME_DIR=./themes

# Theme (optional, without .css — e.g. example)
# THEME=

# Default deck file (without .md extension)
DECK=template.md