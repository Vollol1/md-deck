#!/usr/bin/env bash
# md-deck preview/export wrapper
#
# This file was auto-generated by md-deck/setup.sh in submodule mode.
# It passes --env-file explicitly so docker-compose resolves ${SLIDES_DIR}
# from the project-root deck.env, because Compose only reads .env from
# the directory containing docker-compose.yml.
#
# Usage:
#   ./run-deck.sh              # start preview server
#   ./run-deck.sh --build      # rebuild image before starting
#   ./run-deck.sh --md <file>  # print direct deck URL
#
# After start open:
#   http://localhost:5173
# or directly:
#   http://localhost:5173/?md=<your-deck>.md

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/deck.env"

# Locate the engine directory. The wrapper keeps the engine either as a
# submodule named decks/ or next to the wrapper as md-deck/. Override with
# DECK_ENGINE_DIR if you use a different layout.
if [ -n "${DECK_ENGINE_DIR:-}" ]; then
    COMPOSE_DIR="${SCRIPT_DIR}/${DECK_ENGINE_DIR}"
else
    COMPOSE_DIR=""
    for candidate in decks ../md-deck; do
        if [ -f "${SCRIPT_DIR}/${candidate}/docker-compose.yml" ]; then
            COMPOSE_DIR="${SCRIPT_DIR}/${candidate}"
            break
        fi
    done
fi

if [ -z "$COMPOSE_DIR" ] || [ ! -f "${COMPOSE_DIR}/docker-compose.yml" ]; then
    echo "Error: md-deck engine not found." >&2
    echo "Looked for decks/ and ../md-deck/ relative to ${SCRIPT_DIR}." >&2
    echo "Clone the engine as decks/ or set DECK_ENGINE_DIR=<path>." >&2
    exit 1
fi

if [ ! -f "$ENV_FILE" ]; then
    echo "Error: ${ENV_FILE} not found. Run md-deck/setup.sh first or create it manually." >&2
    exit 1
fi

cd "$COMPOSE_DIR"

BUILD=""
DECK_ARG=""

while [ $# -gt 0 ]; do
    case "$1" in
        --build)
            BUILD="--build"
            ;;
        --md)
            shift
            DECK_ARG="?md=${1}"
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Usage: $0 [--build] [--md <deck-file>]" >&2
            exit 1
            ;;
    esac
    shift
done

docker compose --env-file "$ENV_FILE" up preview ${BUILD:-} -d

echo ""
echo "md-deck preview started."
if [ -n "$DECK_ARG" ]; then
    echo "Open: http://localhost:5173/${DECK_ARG}"
else
    echo "Open: http://localhost:5173"
    echo "Or directly: http://localhost:5173/?md=<your-deck>.md"
fi
